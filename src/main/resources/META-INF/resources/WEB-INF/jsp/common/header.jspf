<%-- Shared top of every logged-in page (static include: copied into each JSP when it is compiled). --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${pageTitle} · Arbitrage Portal</title>
  <link rel="stylesheet" href="${pageContext.request.contextPath}/portal-assets/portal.css">
</head>
<body>
<div class="shell">
  <aside class="side">
    <a class="brand" href="${pageContext.request.contextPath}/portal">
      <span class="brand-mark"><svg width="18" height="18" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 6 L26 23 L6 23 Z" fill="none" stroke="#fff" stroke-width="3" stroke-linejoin="round"/></svg></span>
      Arbitrage Portal
    </a>
    <nav class="nav" aria-label="Portal">
      <a href="${pageContext.request.contextPath}/portal" class="${page == 'dashboard' ? 'on' : ''}">Dashboard</a>
      <a href="${pageContext.request.contextPath}/portal/route" class="${page == 'route' ? 'on' : ''}">Send money <span class="tag">new</span></a>
      <a href="${pageContext.request.contextPath}/portal/history" class="${page == 'history' || page == 'opportunity' ? 'on' : ''}">History</a>
      <a href="${pageContext.request.contextPath}/portal/alerts" class="${page == 'alerts' ? 'on' : ''}">Alerts</a>
      <a href="${pageContext.request.contextPath}/portal/currencies" class="${page == 'currencies' ? 'on' : ''}">Currencies</a>
      <a href="${pageContext.request.contextPath}/portal/rubric" class="${page == 'rubric' ? 'on' : ''}">Rubric map</a>
    </nav>
    <div class="side-foot">
      <span class="muted">Logged in as</span>
      <strong><c:out value="${sessionScope.user.displayName}"/></strong>
      <form class="inline" method="post" action="${pageContext.request.contextPath}/portal/logout">
        <input type="hidden" name="csrf" value="${sessionScope.csrf}">
        <button class="btn sm quiet" type="submit" style="padding-left:0">Log out</button>
      </form>
    </div>
  </aside>
  <main class="main">
    <c:if test="${not empty flash}">
      <div class="notice good" role="status"><c:out value="${flash}"/></div>
    </c:if>
